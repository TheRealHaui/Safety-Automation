/tmp/resilience-tester
/bin
/tmp/build-errors.log
/resources-local-development-only/red-hat-chart-verifier/chart-verifier
/chartverifier/verifier*.log
/resources-local-development-only/trivy-grype/trivy
resources-local-development-only/trivy-grype/grype

# IDE settings (personal, not part of the project)
.idea/

# ── Local secrets — must NEVER be committed (this repository is public) ──────
# The Makefile loads resources-local-development-only/.env and TNS_ADMIN points
# at resources-local-development-only/Wallet_devdb/, so both live inside the
# working tree during local development. Without these rules a routine
# `git add -A` would publish the DB password and the Oracle wallet.
# `.env` without a slash matches at any depth; `.env.example` stays tracked.
.env
resources-local-development-only/Wallet_devdb/

# Safety net for credential files wherever they end up: Oracle wallet files,
# keystores, private keys, and GCP service-account keys (e.g. the sa-key.json
# license file used for registry pull secrets).
cwallet.sso
ewallet.p12
ewallet.pem
*.jks
*.p12
*.key
sa-key.json
*-key.json