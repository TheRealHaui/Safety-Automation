# ─── Safety Automation – Local Development Environment ───────────────────────
# Copy this file to resources-local-development-only/.env — that is the file `make run` /
# `make dev` load (see ENV_FILE in the Makefile). It is further git-ignored and never commit it.

# Application
export APP_PORT=8080

# Oracle Cloud DB (wallet-based)
# TNS_ADMIN must point to the directory containing your wallet files (cwallet.sso, tnsnames.ora, etc.)
export TNS_ADMIN=/path/to/your/wallet

# DSN format for godror with Oracle wallet:
# username/password@service_alias
# The service alias matches an entry in tnsnames.ora inside your wallet directory.
export ORACLE_DSN="admin/YourPassword@your_service_high"

# OpenShift / Kubernetes
# Leave empty to auto-detect from KUBECONFIG env var or ~/.kube/config
export KUBECONFIG_PATH=""
# If using oc login, KUBECONFIG is usually set automatically. Otherwise:
# export KUBECONFIG_PATH=/home/youruser/.kube/config

# Test execution
export MAX_PARALLEL_TESTS=4
export K6_IMAGE=grafana/k6:latest
export K6_TIMEOUT_SECONDS=300

# Session security (change both in production!)
# SESSION_SECRET  — HMAC signing key (32 or 64 random bytes)
export SESSION_SECRET="replace-with-a-32-byte-random-string-here"
# SESSION_ENCRYPT_KEY — AES encryption key (16, 24, or 32 random bytes, distinct from SESSION_SECRET)
# Without SESSION_ENCRYPT_KEY the app starts with a warning and cookie contents are readable in DevTools.
export SESSION_ENCRYPT_KEY="replace-with-a-16-or-32-byte-key"
